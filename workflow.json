    {
      "parameters": {
        "jsCode": "// 1. 模型返回的字符串\nconst raw = $json.choices?.[0]?.message?.content ?? \"\";\n\n// 2. 剥掉模型可能加的 ```json 围栏\nconst cleaned = raw.trim().replace(/^```(?:json)?\\s*/i, \"\").replace(/```$/, \"\").trim();\n\n// 3. 解析\nlet data;\ntry {\n  data = JSON.parse(cleaned);\n} catch (e) {\n  throw new Error(\"Model returned non-JSON: \" + raw.slice(0, 300));\n}\n\n// 4. 发件人：从 header 取，再只留尖括号里的邮箱地址\nconst g = $('Gmail Trigger').first().json ?? {};\nfunction getHeader(name) {\n  const cand = g?.payload?.headers ?? g?.headers;\n  if (Array.isArray(cand)) {\n    const hit = cand.find(h => String(h?.name ?? h?.Name ?? \"\").toLowerCase() === name);\n    return hit?.value ?? hit?.Value ?? \"\";\n  }\n  if (cand && typeof cand === \"object\") {\n    const k = Object.keys(cand).find(x => x.toLowerCase() === name);\n    return k ? String(cand[k]) : \"\";\n  }\n  return g?.from?.value?.[0]?.address ?? g?.from?.text ?? \"\";\n}\nconst rawFrom = getHeader(\"from\");\nconst m = String(rawFrom).match(/<([^>]+)>/);\nconst from = m ? m[1] : String(rawFrom).replace(/^From:\\s*/i, \"\").trim();\n\n// 5. 日期按北京时间算（服务器是 UTC，早上 8 点前会差一天）\nconst date = new Date(Date.now() + 8 * 3600 * 1000).toISOString().slice(0, 10);\n\nreturn [{\n  json: {\n    date,\n    from,\n    vendor: data.vendor ?? null,\n    invoice_no: data.invoice_no ?? null,\n    amount: data.amount ?? null,\n    currency: data.currency ?? null,\n    due_date: data.due_date ?? null,\n    summary: data.summary ?? null,\n  },\n}];\n"
      },
