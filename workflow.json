        "jsonBody": "={\n  \"model\": \"glm-4-flash\",\n  \"temperature\": 0.1,\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You extract structured data from invoice text. Reply with exactly one JSON object and nothing else - no explanation, no markdown fences. Required keys: vendor (supplier name as written), invoice_no (as written), amount (total amount due, number only), currency (3-letter ISO code), due_date (YYYY-MM-DD), summary (one short English sentence on what was purchased). Use null only when a value is genuinely absent. Never invent values.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": {{ JSON.stringify($json.text) }}\n    }\n  ]\n}\n",
        "options": {}
